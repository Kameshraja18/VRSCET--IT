{
  "name": "college-management-system",
  "version": "1.0.0",
  "description": "MERN Stack College Management System",
  "main": "index.js",
  "scripts": {
    "install:all": "npm run install:backend && npm run install:frontend",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "build:all": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "seed": "cd backend && npm run seed",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "clean": "rm -rf backend/node_modules frontend/node_modules && npm run install:all"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/college-management-system.git"
  },
  "keywords": [
    "mern",
    "college-management",
    "education",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "Krish Jotaniya",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-username/college-management-system/issues"
  },
  "homepage": "https://github.com/your-username/college-management-system#readme"
}