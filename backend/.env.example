# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/college-management
# For production, use MongoDB Atlas or your cloud database URL
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/college-management

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
JWT_EXPIRE=7d

# Server Configuration
PORT=4000
NODE_ENV=development

# Email Configuration (for password reset, notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
UPLOAD_PATH=./media
MAX_FILE_SIZE=5242880

# Admin Seeder (only for initial setup)
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=admin123
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator